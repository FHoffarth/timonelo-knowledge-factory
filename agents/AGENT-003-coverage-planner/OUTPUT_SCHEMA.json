{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent003Output",
  "description": "Dedicated output schema for AGENT-003 Coverage Planner. References evidence-acquisition-plan.schema.json.",
  "type": "object",
  "required": [
    "entity_slug",
    "computed_at",
    "coverage",
    "recommended_next_document",
    "roadmap"
  ],
  "properties": {
    "entity_slug": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "coverage": {
      "type": "object",
      "required": ["answered", "unknown", "coverage_percent"],
      "properties": {
        "answered":         { "type": "integer", "minimum": 0 },
        "unknown":          { "type": "integer", "minimum": 0 },
        "coverage_percent": { "type": "number",  "minimum": 0.0, "maximum": 100.0 }
      },
      "additionalProperties": false
    },
    "recommended_next_document": {
      "type": "object",
      "required": ["document_class", "expected_new_statements", "expected_unknown_reduction_percent"],
      "properties": {
        "document_class":                     { "type": "string" },
        "expected_new_statements":            { "type": "integer", "minimum": 0 },
        "expected_unknown_reduction_percent": { "type": "number",  "minimum": 0.0, "maximum": 100.0 }
      },
      "additionalProperties": false
    },
    "roadmap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["priority", "document_class", "expected_new_statements", "expected_unknown_reduction_percent"],
        "properties": {
          "priority":                           { "type": "integer", "minimum": 1 },
          "document_class":                     { "type": "string" },
          "expected_new_statements":            { "type": "integer", "minimum": 0 },
          "expected_unknown_reduction_percent": { "type": "number",  "minimum": 0.0, "maximum": 100.0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
