{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IngestedArtifact",
  "description": "A registered artifact produced by the Truth Engine Connector Bridge. Trust evaluation is exclusively performed by the Truth Engine, not by the connector.",
  "type": "object",
  "required": [
    "artifact_id",
    "candidate_id",
    "storage_path",
    "mime_type",
    "sha256",
    "source_url",
    "provenance",
    "ingested_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^art-[a-z0-9-]+$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[a-z0-9-]+$"
    },
    "storage_path": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "provenance": {
      "type": "object",
      "description": "Immutable passthrough of source provenance from the ArtifactCandidate. Trust evaluation is NOT performed here.",
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "OFFICIAL_SHIPYARD",
            "OFFICIAL_AUTHORITY",
            "OPERATOR_TECHNICAL",
            "DECK_OFFICER_LOG",
            "MARITIME_REGISTRY"
          ]
        },
        "authoritative_publisher": {
          "type": "string",
          "description": "Preserved verbatim from ArtifactCandidate.extracted_metadata.authoritative_publisher. Never synthesized."
        }
      },
      "additionalProperties": false
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
