{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeStatement",
  "type": "object",
  "required": [
    "statement_id",
    "subject_slug",
    "predicate",
    "object_value",
    "source_artifact_id",
    "confidence",
    "is_inherited"
  ],
  "properties": {
    "statement_id": {
      "type": "string",
      "pattern": "^stmt-[a-z0-9-]+$"
    },
    "subject_slug": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object_value": {},
    "source_artifact_id": {
      "type": "string",
      "pattern": "^art-[a-z0-9-]+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "is_inherited": {
      "type": "boolean"
    },
    "inheritance_reference": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
